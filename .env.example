# Copy this file to .env and fill it in. Without it the email server uses a free test inbox.
PORT=4000
MAIL_FROM=Equinix Simulator <your-address@example.com>

# Real delivery through your mail account (set MAIL_MODE=smtp, or just fill in SMTP_HOST).
# Gmail example: host smtp.gmail.com, port 465, your address, and an App Password (not your normal password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-app-password
# MAIL_MODE=smtp

# Outlook.com demo delivery. Use an app password if your account has two-step verification enabled.
# For Microsoft 365 work accounts, set SMTP_HOST=smtp.office365.com instead.
# MAIL_MODE=outlook
# SMTP_USER=your-address@outlook.com
# SMTP_PASS=your-app-password
# MAIL_FROM=Equinix Simulator <your-address@outlook.com>
